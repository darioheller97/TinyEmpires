[Unit]
Description=Tiny Empires game server (Colyseus + static client)
After=network.target

[Service]
WorkingDirectory=/opt/TinyEmpires
Environment=PORT=3060
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/TinyEmpires/server/dist/index.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
